#!/usr/bin/env bash
# lunar-sdboot-update - keep systemd-boot entries in sync with the installed kernels.
#
# For every kernel package (/usr/lib/modules/*/pkgbase) it writes
#   $ESP/loader/entries/lunar-<pkgbase>.conf           (normal initramfs)
#   $ESP/loader/entries/lunar-<pkgbase>-fallback.conf  (if a fallback image exists)
# pointing at the files mkinitcpio puts in /boot (vmlinuz-<pkgbase>,
# initramfs-<pkgbase>.img), with the options from /etc/kernel/cmdline
# (written by lunar-update-cmdline). Entries of removed kernels are deleted.
# linux-lunar is the default entry; another kernel only if it is missing.
#
# Run by lunar-update-cmdline, which a pacman hook (95-lunar-boot.hook) starts
# after kernel installs, upgrades and removals.
# Does nothing on systems that don't boot with systemd-boot or aren't Lunar
# installs (no /etc/lunar/cmdline-root).

set -euo pipefail

CMDLINE=/etc/kernel/cmdline
DEFAULT_KERNEL=linux-lunar

log() { echo "==> lunar-sdboot: $*"; }

# Only on Lunar installs (lunar-update-cmdline needs the same file), so the
# package never touches the boot setup of another distribution.
[[ -s /etc/lunar/cmdline-root ]] || exit 0
command -v bootctl >/dev/null || exit 0
bootctl is-installed >/dev/null 2>&1 || exit 0
esp="$(bootctl --print-esp-path 2>/dev/null)" || exit 0
entries="$esp/loader/entries"
loader="$esp/loader/loader.conf"

if [[ "$(stat -c %d "$esp")" != "$(stat -c %d /boot)" ]]; then
    log "WARNING: the EFI partition ($esp) is not mounted at /boot, so systemd-boot"
    log "can't read the kernels in /boot. Mount the EFI partition at /boot."
    exit 1
fi
if [[ ! -s "$CMDLINE" ]]; then
    log "no $CMDLINE yet (run lunar-update-cmdline), leaving the entries alone"
    exit 0
fi
options="$(tr -s '[:space:]' ' ' < "$CMDLINE" | sed 's/^ //; s/ $//')"

mkdir -p "$entries"

write_entry() {  # file title kver pkgbase initramfs sortkey
    local tmp
    tmp="$(mktemp)"
    cat > "$tmp" <<EOF
# Generated by lunar-sdboot-update - changes are overwritten on the next kernel update.
title    $2
sort-key $6
version  $3
linux    /vmlinuz-$4
initrd   /$5
options  $options
EOF
    if ! cmp -s "$tmp" "$1"; then
        install -m644 "$tmp" "$1"
        log "wrote ${1##*/}"
    fi
    rm -f "$tmp"
}

declare -A keep=()
shopt -s nullglob
for pkgbase_file in /usr/lib/modules/*/pkgbase; do
    pkgbase="$(<"$pkgbase_file")"
    kver="$(basename "$(dirname "$pkgbase_file")")"
    [[ -f "/boot/vmlinuz-$pkgbase" && -f "/boot/initramfs-$pkgbase.img" ]] || {
        log "skipping $pkgbase: /boot/vmlinuz-$pkgbase or its initramfs is missing"
        continue
    }
    # linux-lunar sorts first in the menu
    [[ "$pkgbase" == "$DEFAULT_KERNEL" ]] && sort="lunar-1-$pkgbase" || sort="lunar-2-$pkgbase"

    f="$entries/lunar-$pkgbase.conf"
    write_entry "$f" "Lunar ($pkgbase)" "$kver" "$pkgbase" "initramfs-$pkgbase.img" "$sort"
    keep["${f##*/}"]=1

    if [[ -f "/boot/initramfs-$pkgbase-fallback.img" ]]; then
        f="$entries/lunar-$pkgbase-fallback.conf"
        write_entry "$f" "Lunar ($pkgbase, fallback initramfs)" "$kver" "$pkgbase" \
            "initramfs-$pkgbase-fallback.img" "lunar-9-$pkgbase"
        keep["${f##*/}"]=1
    fi
done

for f in "$entries"/lunar-*.conf; do
    if [[ -z "${keep[${f##*/}]:-}" ]]; then
        rm -f "$f"
        log "removed ${f##*/}"
    fi
done

# default entry: keep a user's choice unless it points at a removed lunar entry
default=""
[[ -f "$loader" ]] && default="$(sed -n 's/^default[[:space:]]\+//p' "$loader" | tail -n1)"
if [[ -z "$default" || ( "$default" == lunar-* && ! -f "$entries/$default" ) ]]; then
    if [[ -f "$entries/lunar-$DEFAULT_KERNEL.conf" ]]; then
        default="lunar-$DEFAULT_KERNEL.conf"
    else
        default=""
        for f in "$entries"/lunar-*.conf; do
            [[ "$f" == *-fallback.conf ]] && continue
            default="${f##*/}"
            break
        done
    fi
    if [[ -n "$default" ]]; then
        touch "$loader"
        sed -i '/^default[[:space:]]/d' "$loader"
        echo "default $default" >> "$loader"
        log "default entry: $default"
    fi
fi
grep -q '^timeout[[:space:]]' "$loader" 2>/dev/null || echo "timeout 3" >> "$loader"
exit 0
