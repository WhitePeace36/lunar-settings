#!/usr/bin/env bash
# lunar-update-cmdline - build the kernel command line and apply it.
#
# /etc/kernel/cmdline is put together in this order:
#
#   1. /etc/lunar/cmdline-root          this machine's root options, written by
#                                        the installer (root=, LUKS, Btrfs
#                                        subvolume, rw, quiet splash)
#   2. /usr/lib/lunar/cmdline.d/*.conf   Lunar's parameters (lunar-settings),
#                                        left out with LUNAR_DEFAULTS=no
#   3. /etc/lunar/cmdline.d/*.conf       the user's own parameters
#
# Within 2 and 3 the files are read in name order. Nothing is removed or
# merged: when a parameter appears twice, the kernel uses the last one, so the
# user's parameters (3) always come last and win.
#
# /etc/lunar/cmdline.conf:
#   LUNAR_DEFAULTS=yes   1 + 2 + 3 (default)
#   LUNAR_DEFAULTS=no    1 + 3 only: none of Lunar's parameters
#
# Afterwards the systemd-boot entries are rewritten (lunar-sdboot-update).
# A pacman hook runs this after kernel and lunar-settings updates.
#
# Options:
#   --no-regen  only write /etc/kernel/cmdline
#   --print     print the command line that would be written, and exit

set -euo pipefail

ROOT_FILE=/etc/lunar/cmdline-root
SYS_DIR=/usr/lib/lunar/cmdline.d
ETC_DIR=/etc/lunar/cmdline.d
CONF=/etc/lunar/cmdline.conf
OUT=/etc/kernel/cmdline

regen=1
print_only=0
for arg in "$@"; do
    case "$arg" in
        --no-regen) regen=0 ;;
        --print) print_only=1 ;;
        -h|--help) sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "lunar-update-cmdline: unknown option '$arg'" >&2; exit 2 ;;
    esac
done

# words from files, comments stripped
words_of() { sed -e 's/#.*$//' "$@" | tr -s '[:space:]' '\n' | sed '/^$/d'; }

# all words of the *.conf files in a folder, files in name order
words_of_dir() {
    local f
    shopt -s nullglob
    for f in "$1"/*.conf; do words_of "$f"; done
    shopt -u nullglob
}

use_defaults() {
    local v=""
    [[ -f "$CONF" ]] && v="$(sed -n 's/^[[:space:]]*LUNAR_DEFAULTS[[:space:]]*=[[:space:]]*//p' "$CONF" | tail -n1)"
    v="${v%%#*}"; v="${v//[[:space:]\"\']/}"
    case "${v,,}" in
        no|false|0|off) return 1 ;;
        *) return 0 ;;
    esac
}

build() {
    [[ -s "$ROOT_FILE" ]] && words_of "$ROOT_FILE"
    if use_defaults; then words_of_dir "$SYS_DIR"; fi
    words_of_dir "$ETC_DIR"
}

if [[ "$print_only" == 1 ]]; then
    build | paste -sd ' '
    exit 0
fi

[[ "$(id -u)" -eq 0 ]] || { echo "lunar-update-cmdline: must be run as root" >&2; exit 1; }

# Only Lunar installs have it (the installer writes it). Elsewhere, and while
# the installer is still installing packages, the boot setup is left alone.
if [[ ! -s "$ROOT_FILE" ]]; then
    echo "lunar-update-cmdline: no $ROOT_FILE (not a Lunar install, or not set up yet)," >&2
    echo "  leaving $OUT and the boot entries alone." >&2
    exit 0
fi

new="$(build | paste -sd ' ')"
mkdir -p "${OUT%/*}"
if [[ "$(cat "$OUT" 2>/dev/null)" != "$new" ]]; then
    echo "$new" > "$OUT"
    echo "==> lunar: kernel command line: $new"
    echo "==> lunar: takes effect after a reboot"
fi

if [[ "$regen" == 1 ]]; then
    /usr/bin/lunar-sdboot-update
fi
