diff --git a/battery/usr/lib/sysctl.d/75-lunar-tuning.conf b/battery/usr/lib/sysctl.d/75-lunar-tuning.conf
deleted file mode 100644
index f2cff51..0000000
--- a/battery/usr/lib/sysctl.d/75-lunar-tuning.conf
+++ /dev/null
@@ -1,18 +0,0 @@
-# Lunar battery profile - values that differ from the performance profile.
-# linux-lunar's compiled-in memory defaults keep kswapd/kcompactd busy in the
-# background to avoid allocation stalls in games; on battery that trade is
-# turned back towards upstream, so the CPU wakes up less.
-
-# No proactive compaction: kcompactd otherwise wakes every 500 ms to check
-# fragmentation (linux-lunar: 50, upstream: 20)
-vm.compaction_proactiveness = 0
-# Don't keep whole free 2 MiB blocks around in the background
-# (linux-lunar: 1). vm.defrag_soft only matters with defrag_mode=1.
-vm.defrag_mode = 0
-# kswapd keeps less memory free, so it reclaims and compresses to zram less
-# often (70-lunar.conf / linux-lunar: 500, upstream: 10)
-vm.watermark_scale_factor = 125
-# Flush dirty pages every 15 s instead of every second and let data wait up
-# to 30 s (upstream), so writes are batched and disks can idle
-vm.dirty_writeback_centisecs = 1500
-vm.dirty_expire_centisecs = 3000
