+# Lunar kernel parameters, on top of the root/LUKS options the installer
+# wrote to /etc/lunar/cmdline-root. lunar-update-cmdline puts them into
+# /etc/kernel/cmdline and the systemd-boot entries. To drop or change some:
+# copy this file to /etc/lunar/cmdline.d/10-lunar.conf, edit it there, then
+# run  sudo lunar-update-cmdline  (a file in /etc replaces the one here).
+
+# quiet boot
+loglevel=3
+rd.systemd.show_status=false
+
+# no watchdogs, no audit
+nmi_watchdog=0
+nowatchdog
+audit=0
+
+# CPU idle: only C1 (processor.* for acpi_idle, mostly AMD; intel_idle.* for Intel)
+processor.max_cstate=1
+intel_idle.max_cstate=1
+# no PCIe link power saving
+pcie_aspm=off
+# periodic tick and the performance governor (the distro kernel is built
+# with an idle tick and schedutil)
+nohz=off
+cpufreq.default_governor=performance
+preempt=full
+
+# memory
+transparent_hugepage=always
+transparent_hugepage_tmpfs=always
+zswap.enabled=0
+
+# misc
+split_lock_detect=off
+libahci.ignore_sss=1
